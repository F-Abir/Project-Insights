/*******************************************************
 RSEI (PCA) — MEMORY-OPTIMIZED GEE script for Gazipur
 - Multi-year time series with global min-max normalization BEFORE PCA
 - Temporally consistent approach for accurate trend analysis
 - FIXED: PCA matrix multiplication and correlation calculation
*******************************************************/

// ----------------------------
// PARAMETERS (Reduced for efficiency)
// ----------------------------
var startYear = 2015;
var endYear = 2024; // Reduced range to prevent timeout
var analysisScale = 90; // Increased to reduce memory usage
var maxPixelsSample = 1000; // Reduced sample size

// ----------------------------
// 1) Load Gazipur AOI
// ----------------------------
var gaul = ee.FeatureCollection('FAO/GAUL/2015/level2');
var gazipur = gaul.filter(ee.Filter.and(
  ee.Filter.eq('ADM0_NAME', 'Bangladesh'),
  ee.Filter.eq('ADM2_NAME', 'Gazipur')
));

Map.centerObject(gazipur, 10);
Map.addLayer(gazipur.style({color: 'FF0000', width: 2}), {}, 'Gazipur');

// ----------------------------
// 2) Processing functions
// ----------------------------

function maskL8sr(image) {
  var qa = image.select('QA_PIXEL');
  var mask = qa.bitwiseAnd(1 << 3).eq(0).and(qa.bitwiseAnd(1 << 4).eq(0));
  return image.updateMask(mask);
}

function convertLandsatLST(image) {
  return image.select('ST_B10')
    .multiply(0.00341802).add(149.0).subtract(273.15)
    .rename('LST').updateMask(image.select('QA_PIXEL').bitwiseAnd(1 << 3).eq(0));
}

function computeYearlyIndicators(year) {
  var startDate = ee.Date.fromYMD(year, 1, 1);
  var endDate = ee.Date.fromYMD(year, 12, 31);
  
  var l8sr = ee.ImageCollection('LANDSAT/LC08/C02/T1_L2')
    .filterBounds(gazipur.geometry())
    .filterDate(startDate, endDate)
    .map(maskL8sr);
  
  var imageCount = l8sr.size();
  var median = l8sr.median().clip(gazipur.geometry());
  
  // Compute indicators efficiently
  var ndvi = median.normalizedDifference(['SR_B5', 'SR_B4']).rename('NDVI');
  
  var wet = median.expression(
    '0.1511*B2 + 0.1973*B3 + 0.3283*B4 + 0.3407*B5 - 0.7117*B6 - 0.4559*B7', {
      'B2': median.select('SR_B2'), 'B3': median.select('SR_B3'),
      'B4': median.select('SR_B4'), 'B5': median.select('SR_B5'),
      'B6': median.select('SR_B6'), 'B7': median.select('SR_B7')
    }).rename('WET');
  
  var ndbi = median.normalizedDifference(['SR_B6', 'SR_B5']);
  var bsi = median.expression('((B6+B4)-(B5+B2))/((B6+B4)+(B5+B2))', {
    'B6': median.select('SR_B6'), 'B4': median.select('SR_B4'),
    'B5': median.select('SR_B5'), 'B2': median.select('SR_B2')
  });
  var ndbsi = ndbi.add(bsi).multiply(0.5).rename('NDBSI');
  
  var lst = l8sr.map(convertLandsatLST).median().clip(gazipur.geometry());
  
  return ee.Image.cat([ndvi, wet, ndbsi, lst])
    .rename(['NDVI', 'WET', 'NDBSI', 'LST'])
    .set({'year': year, 'image_count': imageCount});
}

// ----------------------------
// 3) STEP 1: Compute all yearly indicators first
// ----------------------------

print('Starting temporally consistent RSEI analysis...');
var years = ee.List.sequence(startYear, endYear);
print('Processing years:', years);

print('Step 1: Computing indicators for all years...');
var indicatorImages = years.map(computeYearlyIndicators);
var indicatorCollection = ee.ImageCollection(indicatorImages);

print('Indicator collection size:', indicatorCollection.size());

// ----------------------------
// 4) STEP 2: Calculate GLOBAL min-max for each indicator BEFORE PCA
// ----------------------------

print('Step 2: Computing global min-max for indicators across ALL years...');

// Calculate global statistics by processing all years together
// First, create a single image with all years as bands
var allYearsImage = indicatorCollection.toBands();

// Sample from all bands to get global statistics
var globalSample = allYearsImage.sample({
  region: gazipur.geometry(),
  scale: analysisScale,
  numPixels: 2000,
  seed: 42,
  geometries: false
});

// Calculate min-max for each indicator type across all year-bands
var bandNames = allYearsImage.bandNames();

// Extract values for each indicator across all years
var ndviBands = bandNames.filter(ee.Filter.stringContains('item', 'NDVI'));
var wetBands = bandNames.filter(ee.Filter.stringContains('item', 'WET'));
var ndbsiBands = bandNames.filter(ee.Filter.stringContains('item', 'NDBSI'));
var lstBands = bandNames.filter(ee.Filter.stringContains('item', 'LST'));

print('NDVI bands found:', ndviBands.size());
print('WET bands found:', wetBands.size());

// Function to calculate global min-max for an indicator
function calculateIndicatorGlobalStats(sampleData, indicatorBands) {
  var firstBand = ee.String(indicatorBands.get(0));
  var allValues = sampleData.aggregate_array(firstBand);
  
  // Combine values from all years for this indicator
  var combinedValues = indicatorBands.slice(1).iterate(function(bandName, acc) {
    var bandValues = sampleData.aggregate_array(bandName);
    return ee.List(acc).cat(bandValues);
  }, allValues);
  
  var statsArray = ee.Array(combinedValues);
  var minVal = statsArray.reduce(ee.Reducer.min(), [0]).get([0]);
  var maxVal = statsArray.reduce(ee.Reducer.max(), [0]).get([0]);
  
  return ee.Dictionary({
    'min': minVal,
    'max': maxVal
  });
}

// Calculate global statistics for each indicator
var ndviStats = calculateIndicatorGlobalStats(globalSample, ndviBands);
var wetStats = calculateIndicatorGlobalStats(globalSample, wetBands);
var ndbsiStats = calculateIndicatorGlobalStats(globalSample, ndbsiBands);
var lstStats = calculateIndicatorGlobalStats(globalSample, lstBands);

var ndviGlobalMin = ndviStats.get('min');
var ndviGlobalMax = ndviStats.get('max');
var wetGlobalMin = wetStats.get('min');
var wetGlobalMax = wetStats.get('max');
var ndbsiGlobalMin = ndbsiStats.get('min');
var ndbsiGlobalMax = ndbsiStats.get('max');
var lstGlobalMin = lstStats.get('min');
var lstGlobalMax = lstStats.get('max');

// Create global normalization constants
var globalMins = ee.Image.constant([ndviGlobalMin, wetGlobalMin, ndbsiGlobalMin, lstGlobalMin])
  .rename(['NDVI', 'WET', 'NDBSI', 'LST']);

var globalMaxs = ee.Image.constant([ndviGlobalMax, wetGlobalMax, ndbsiGlobalMax, lstGlobalMax])
  .rename(['NDVI', 'WET', 'NDBSI', 'LST']);

var globalRanges = globalMaxs.subtract(globalMins);

// Prevent division by zero
globalRanges = globalRanges.where(globalRanges.lte(0), ee.Image.constant(1));

print('Global indicator ranges computed:');
print('NDVI range:', ee.Number(ndviGlobalMax).subtract(ee.Number(ndviGlobalMin)));
print('WET range:', ee.Number(wetGlobalMax).subtract(ee.Number(wetGlobalMin)));
print('NDBSI range:', ee.Number(ndbsiGlobalMax).subtract(ee.Number(ndbsiGlobalMin)));
print('LST range:', ee.Number(lstGlobalMax).subtract(ee.Number(lstGlobalMin)));

print('Global Min values - NDVI:', ndviGlobalMin, 'WET:', wetGlobalMin, 'NDBSI:', ndbsiGlobalMin, 'LST:', lstGlobalMin);
print('Global Max values - NDVI:', ndviGlobalMax, 'WET:', wetGlobalMax, 'NDBSI:', ndbsiGlobalMax, 'LST:', lstGlobalMax);

// ----------------------------
// 5) STEP 3: Apply global normalization to ALL indicators
// ----------------------------

print('Step 3: Applying global min-max normalization to all indicators...');

function globallyNormalizeIndicators(indicatorImg) {
  var year = indicatorImg.get('year');
  var normalized = indicatorImg.subtract(globalMins).divide(globalRanges).clamp(0, 1);
  return normalized.set('year', year);
}

var globallyNormalizedCollection = indicatorCollection.map(globallyNormalizeIndicators);

print('Global normalization applied to all years');

// ----------------------------
// 6) STEP 4: Compute PCA transformation matrix using normalized data
// ----------------------------

print('Step 4: Computing PCA transformation matrix from globally normalized data...');

// Use first year of globally normalized data for PCA matrix calculation
var referenceNormalized = ee.Image(globallyNormalizedCollection.first());

// For PCA, we still need to center the data (subtract mean)
var refStats = referenceNormalized.reduceRegion({
  reducer: ee.Reducer.mean(),
  geometry: gazipur.geometry(),
  scale: analysisScale,
  maxPixels: 1e8,
  bestEffort: true
});

var refMeans = ee.Image.constant([
  refStats.get('NDVI'),
  refStats.get('WET'), 
  refStats.get('NDBSI'),
  refStats.get('LST')
]).rename(['NDVI', 'WET', 'NDBSI', 'LST']);

// Center the data for PCA (subtract mean, don't divide by std since already normalized)
var centeredRef = referenceNormalized.subtract(refMeans);

// Compute PCA matrix
var arrayImage = centeredRef.toArray();
var covMatrix = arrayImage.reduceRegion({
  reducer: ee.Reducer.centeredCovariance(),
  geometry: gazipur.geometry(),
  scale: analysisScale,
  maxPixels: 1e8,
  bestEffort: true
});

var covArray = ee.Array(covMatrix.get('array'));
var eigens = covArray.eigen();
var eigenVectors = eigens.slice(1, 1);
var eigenValues = eigens.slice(1, 0, 1);

print('PCA matrix computed from globally normalized data');

// FIXED: Check PC1 direction and correlation with proper array handling
var pc1Test = ee.Image(eigenVectors).matrixMultiply(centeredRef.toArray().toArray(1))
  .arrayProject([0]).arrayFlatten([['PC1', 'PC2', 'PC3', 'PC4']]);

// Select only PC1 for correlation analysis
var pc1Only = pc1Test.select('PC1');

var correlationSample = pc1Only.addBands(referenceNormalized.select('NDVI')).sample({
  region: gazipur.geometry(),
  scale: analysisScale,
  numPixels: 500,
  seed: 42,
  geometries: false
});

var ndviCorr = correlationSample.reduceColumns(ee.Reducer.pearsonsCorrelation(), ['PC1', 'NDVI']);
print('PC1-NDVI correlation:', ndviCorr.get('correlation'));

// ----------------------------
// 7) STEP 5: Apply PCA to all globally normalized years
// ----------------------------

print('Step 5: Applying PCA transformation to all years...');

function applyPCAToNormalizedYear(normalizedImg) {
  var year = normalizedImg.get('year');
  
  // Center the globally normalized data
  var centered = normalizedImg.subtract(refMeans);
  
  // Apply PCA transformation - FIXED: proper array handling
  var pcInput = centered.toArray().toArray(1);
  var allPCs = ee.Image(eigenVectors).matrixMultiply(pcInput)
    .arrayProject([0]).arrayFlatten([['PC1', 'PC2', 'PC3', 'PC4']]);
  
  // Extract PC1 only
  var pc1 = allPCs.select('PC1');
  
  // PC1 is now the RSEI (may need sign flip based on NDVI correlation)
  var rsei = ee.Algorithms.If(
    ee.Number(ndviCorr.get('correlation')).gt(0),
    pc1,
    pc1.multiply(-1)
  );
  
  return ee.Image(rsei).rename('RSEI_raw').set('year', year);
}

var rseiRawCollection = globallyNormalizedCollection.map(applyPCAToNormalizedYear);

// ----------------------------
// 8) STEP 6: Final normalization to 0-1 scale for visualization
// ----------------------------

print('Step 6: Final 0-1 scaling for visualization...');

// Calculate min-max of RSEI across all years using sampling approach
var rseiSampleData = rseiRawCollection.map(function(img) {
  return img.sample({
    region: gazipur.geometry(),
    scale: analysisScale,
    numPixels: 1000,
    seed: 42,
    geometries: false
  });
}).flatten();

var rseiGlobalStats = rseiSampleData.reduceColumns({
  reducer: ee.Reducer.minMax(),
  selectors: ['RSEI_raw']
});

var rseiMin = rseiGlobalStats.get('min');
var rseiMax = rseiGlobalStats.get('max');

var rseiRange = ee.Number(rseiMax).subtract(ee.Number(rseiMin));

function finalNormalizeRSEI(img) {
  var year = img.get('year');
  var normalized = img.select('RSEI_raw')
    .subtract(ee.Number(rseiMin))
    .divide(rseiRange)
    .clamp(0, 1)
    .rename('RSEI');
  return normalized.set('year', year);
}

var finalRSEI = rseiRawCollection.map(finalNormalizeRSEI);

print('Final RSEI range:', rseiMin, 'to', rseiMax);

// ----------------------------
// 9) Generate time series and visualization
// ----------------------------

print('Step 7: Generating time series data...');

var timeSeriesData = finalRSEI.map(function(img) {
  var year = img.get('year');
  var meanRSEI = img.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: gazipur.geometry(),
    scale: analysisScale,
    maxPixels: 1e8,
    bestEffort: true
  });
  
  return ee.Feature(null, {
    'year': year,
    'mean_RSEI': meanRSEI.get('RSEI')
  });
});

// Visualization
var latestYear = endYear;
var latestRSEI = finalRSEI.filter(ee.Filter.eq('year', latestYear)).first();
Map.addLayer(latestRSEI, {min: 0, max: 1, palette: ['red', 'yellow', 'green']}, 
  'RSEI ' + latestYear + ' (Global Norm)');

// Create time series chart
var chart = ui.Chart.feature.byFeature(timeSeriesData, 'year', 'mean_RSEI')
  .setChartType('LineChart')
  .setOptions({
    title: 'RSEI Time Series - Gazipur (Global Pre-PCA Normalization)',
    titleTextStyle: {fontSize: 16, bold: true},
    hAxis: {title: 'Year', format: '####'},
    vAxis: {title: 'Mean RSEI', viewWindow: {min: 0, max: 1}},
    series: {0: {lineWidth: 3, pointSize: 6, color: '#2E8B57'}},
    width: 600,
    height: 400
  });

print('RSEI Time Series Chart (Global Pre-PCA Normalization):');
print(chart);

// ----------------------------
// 10) Summary and diagnostics
// ----------------------------

var pc1ExplainedVar = ee.Number(eigenValues.get([0, 0]))
  .divide(eigenValues.reduce(ee.Reducer.sum(), [0]).get([0, 0]))
  .multiply(100);

print('=== TEMPORALLY CONSISTENT RSEI ANALYSIS COMPLETE ===');
print('Approach: Global Min-Max Normalization BEFORE PCA');
print('Years processed:', startYear, 'to', endYear);
print('PC1 explained variance:', pc1ExplainedVar, '%');
print('All years use same indicator normalization bounds');
print('Results are temporally comparable for trend analysis');

// Optional: Export latest year
Export.image.toDrive({
  image: latestRSEI,
  description: 'RSEI_GlobalNorm_' + latestYear + '_Gazipur',
  scale: analysisScale,
  region: gazipur.geometry(),
  maxPixels: 1e8
});
