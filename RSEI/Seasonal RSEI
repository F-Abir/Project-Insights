  description: 'Gazipur_Seasonal_RSEI_Areas_2023_2024',
  fileFormat: 'CSV',
  folder: 'GEE_RSEI_Analysis',
  selectors: ['Year', 'Season', 'Year_Season', 'Category_1_VeryPoor_ha', 'Category_2_Poor_ha', 
             'Category_3_Moderate_ha', 'Category_4_Good_ha', 'Category_5_Excellent_ha', 'Mean_Category']
});

Export.table.toDrive({
  collection: seasonalTimeSeries,
  description: 'Gazipur_Seasonal_RSEI_TimeSeries_2023_2024',
  fileFormat: 'CSV',
  folder: 'GEE_RSEI_Analysis',
  selectors: ['year', 'season', 'year_season', 'mean_RSEI']
});

var summaryStats = seasonalCategoryAreas.map(function(feature) {
  var year = feature.get('Year');
  var season = feature.get('Season');
  var cat1 = ee.Number(feature.get('Category_1_VeryPoor_ha'));
  var cat2 = ee.Number(feature.get('Category_2_Poor_ha'));
  var cat3 = ee.Number(feature.get('Category_3_Moderate_ha'));
  var cat4 = ee.Number(feature.get('Category_4_Good_ha'));
  var cat5 = ee.Number(feature.get('Category_5_Excellent_ha'));
  
  var totalArea = cat1.add(cat2).add(cat3).add(cat4).add(cat5);
  var poorArea = cat1.add(cat2);
  var goodArea = cat4.add(cat5);
  
  var poorPercent = poorArea.divide(totalArea).multiply(100);
  var moderatePercent = cat3.divide(totalArea).multiply(100);
  var goodPercent = goodArea.divide(totalArea).multiply(100);
  
  return ee.Feature(null, {
    'Year': year,
    'Season': season,
    'Total_Area_ha': totalArea,
    'Poor_Combined_ha': poorArea,
    'Moderate_ha': cat3,
    'Good_Combined_ha': goodArea,
    'Poor_Percent': poorPercent,
    'Moderate_Percent': moderatePercent,
    'Good_Percent': goodPercent
  });
});

Export.table.toDrive({
  collection: summaryStats,
  description: 'Gazipur_Seasonal_RSEI_Summary_2023_2024',
  fileFormat: 'CSV',
  folder: 'GEE_RSEI_Analysis'
});

