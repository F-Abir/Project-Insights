// Layer update function
function updateMapLayers(year, season) {
  var layerType = layerTypeSelect.getValue();
  var layers = Map.layers();
  
  // Hide all RSEI layers
  for (var i = 0; i < layers.length(); i++) {
    var layer = layers.get(i);
    var layerName = layer.getName();
    
    if (layerName.indexOf('RSEI') > -1 || layerName.indexOf('Categories') > -1) {
      layer.setShown(false);
    }
  }
  
  // Show selected layers
  var targetRSEI = year + ' ' + season + ' RSEI';
  var targetCategories = year + ' ' + season + ' Categories';
  
  for (var i = 0; i < layers.length(); i++) {
    var layer = layers.get(i);
    var layerName = layer.getName();
    
    if (layerType === 'RSEI Continuous' && layerName === targetRSEI) {
      layer.setShown(true);
    } else if (layerType === 'RSEI Categories' && layerName === targetCategories) {
      layer.setShown(true);
    } else if (layerType === 'Both') {
      if (layerName === targetRSEI || layerName === targetCategories) {
        layer.setShown(true);
      }
    }
  }
}
