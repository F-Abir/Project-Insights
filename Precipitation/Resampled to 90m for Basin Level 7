// =============== GUMBEL FITTING FUNCTION ==============
function fitGumbelAndChart(collection, valueProperty, title, exportPrefix, T_list, timeUnit) {
  var reducer = ee.Reducer.mean()
    .combine({reducer2: ee.Reducer.stdDev(), sharedInputs: true})
    .combine({reducer2: ee.Reducer.count(), sharedInputs: true});
  
  var stats = collection.reduceColumns(reducer, [valueProperty]);
  var xbar = ee.Number(stats.get('mean'));
  var s = ee.Number(stats.get('stdDev'));
  var n = ee.Number(stats.get('count'));
  
  var euler = ee.Number(0.5772156649015329);
  var beta = s.multiply(Math.sqrt(6)).divide(Math.PI);
  var mu = xbar.subtract(euler.multiply(beta));
  
  // Calculate return levels with T in appropriate units
  var rpList = ee.List(T_list).map(function(T) {
    T = ee.Number(T);
    var pNonExc = ee.Number(1).subtract(ee.Number(1).divide(T));
    var term = pNonExc.log().multiply(-1).log();
    var xT = mu.subtract(beta.multiply(term));
    
    // Convert T back to years for display
    var T_years = timeUnit === 'months' ? T.divide(12) : 
                  timeUnit === 'weeks' ? T.divide(52) : T;
    
    return ee.Feature(null, {
      'T_years': T_years, 
      'T_units': T,
      'xT_mm': xT, 
      'source': 'Gumbel'
    });
  });
  var rpFC = ee.FeatureCollection(rpList);
  
  // Empirical Weibull
  var sortedList = collection.sort(valueProperty, false).toList(collection.size());
  var empList = ee.List.sequence(1, n).map(function(rank) {
    rank = ee.Number(rank);
    var f = ee.Feature(sortedList.get(rank.subtract(1)));
    var value = ee.Number(f.get(valueProperty));
    var prob = rank.divide(n.add(1));
    var T = ee.Number(1).divide(ee.Number(1).subtract(prob));
    
    // Convert empirical T to years for display
    var T_years = timeUnit === 'months' ? T.divide(12) : 
                  timeUnit === 'weeks' ? T.divide(52) : T;
    
    return ee.Feature(null, {
      'T_years': T_years,
      'T_units': T,
      'xT_mm': value, 
      'source': 'Empirical'
    });
  });
  var empFC = ee.FeatureCollection(empList);
  
  // Create frequency curve
  var freqChart = ui.Chart.feature.groups({
    features: rpFC.merge(empFC),
    xProperty: 'T_years',
    yProperty: 'xT_mm',
    seriesProperty: 'source'
  })
  .setChartType('ScatterChart')
  .setOptions({
    title: title + ' - Rainfall Frequency Curve (Return Period in YEARS)',
    hAxis: {title: 'Return Period (years)', logScale: true},
    vAxis: {title: 'Rainfall (mm)'},
    pointSize: 6,
    lineWidth: 2,
    series: {
      0: {color: 'blue', lineWidth: 2, pointSize: 6, pointShape: 'circle'},
      1: {color: 'red', lineWidth: 0, pointSize: 8, pointShape: 'diamond'}
    }
  });
  
  print(title + ' - Gumbel Parameters:', {mu: mu, beta: beta, n: n});
  print(title + ' - Time units used:', timeUnit);
  print(freqChart);
  
  // Export tables
  Export.table.toDrive({
    collection: collection,
    description: exportPrefix + '_Data_' + START_YEAR + '_' + END_YEAR,
    fileFormat: 'CSV'
  });
  
  Export.table.toDrive({
    collection: rpFC,
    description: exportPrefix + '_Gumbel_RP_' + START_YEAR + '_' + END_YEAR,
    fileFormat: 'CSV'
  });
}

